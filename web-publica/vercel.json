{
  "rewrites": [
    { "source": "/m/:codigo", "destination": "/m.html" },
    { "source": "/s/:id", "destination": "/s.html" },
    { "source": "/n/:id", "destination": "/n.html" },
    { "source": "/h/:token", "destination": "/h.html" },
    { "source": "/unirme/:codigo", "destination": "/unirme.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(self), camera=(), microphone=()" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
