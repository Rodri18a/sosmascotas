# Secretos y variables de entorno
.env
.env.*
!.env.example

# Configuración local de Claude Code (propia de cada máquina)
.claude/settings.local.json

# Sistema operativo y editores
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Flutter / Dart (para cuando arranque el código)
.dart_tool/
build/
.flutter-plugins
.flutter-plugins-dependencies
*.iml

# Supabase local
supabase/.temp/
supabase/.branches/

# Configuración por entorno de la app (solo se suben los *.example.json)
app/config/*.json
!app/config/*.example.json
admin/config/*.json
!admin/config/*.example.json

# Web pública: la configuración real no se sube
web-publica/config.js

# Python
__pycache__/
